rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /app_data/{documentId} {
      allow read: if documentId in ['board', 'rules'];
      allow create, update: if documentId in ['board', 'rules']
        && request.resource.data.keys().hasOnly(['data'])
        && request.resource.data.data is map;
    }
  }
}
